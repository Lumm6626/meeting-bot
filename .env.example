# ===== 翻译服务（任意 OpenAI 兼容接口）=====
# DeepSeek 官方：https://api.deepseek.com/v1    模型 deepseek-chat
# OpenCode Go ：https://opencode.ai/zen/go/v1   模型 deepseek-v4-pro
OPENCODE_BASE_URL=https://api.deepseek.com/v1
OPENCODE_API_KEY=sk-在此填入你的翻译服务key
TRANSLATE_MODEL=deepseek-chat
MINUTES_MODEL=deepseek-chat

# ===== 语音识别 =====
# groq  = 云端识别（延迟 3~5s，需 GROQ_API_KEY，免费注册 console.groq.com）
# local = 本地识别（零成本不出本机，延迟 30~55s）
ASR_PROVIDER=groq
GROQ_API_KEY=
WHISPER_MODEL=small

# ===== 说话人区分（可选）=====
# 需在 huggingface.co 创建 token，并在三个模型页点 Agree：
#   pyannote/speaker-diarization-3.1 / segmentation-3.0 / wespeaker-voxceleb-resnet34-LM
HF_TOKEN=
DIARIZE_ENABLED=false

# ===== 音频源 =====
# both（默认，扬声器回环+麦克风自动混合）| speaker（仅系统声音）| mic（仅麦克风）
AUDIO_SOURCE=both

# ===== 其他 =====
OUTPUT_DIR=会议记录
# 国内网络下载 HuggingFace 模型走镜像（官方 CDN 常被墙）
HF_ENDPOINT=https://hf-mirror.com
