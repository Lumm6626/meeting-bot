# 密钥（OPENCODE_API_KEY / GROQ_API_KEY / HF_TOKEN）推荐存 Windows 凭据管理器：
#   运行 setup_env.py（首次配置）或 scripts/migrate_keys_to_keyring.py（从本文件迁移）
# 存好后下面三项留空即可；程序优先读凭据管理器，读不到才回退本文件。
# ===== 翻译服务（任意 OpenAI 兼容接口）=====
# DeepSeek 官方：https://api.deepseek.com/v1    模型 deepseek-chat
# OpenCode Go ：https://opencode.ai/zen/go/v1   模型 deepseek-v4-pro
OPENCODE_BASE_URL=https://api.deepseek.com/v1
OPENCODE_API_KEY=sk-在此填入你的翻译服务key
TRANSLATE_MODEL=deepseek-chat
MINUTES_MODEL=deepseek-chat

# ===== 语音识别 =====
# groq  = 云端识别（延迟 3~5s，需 GROQ_API_KEY，免费注册 console.groq.com）
# local = 本地识别（零成本不出本机，延迟 30~55s）
ASR_PROVIDER=groq
GROQ_API_KEY=
WHISPER_MODEL=small

# ===== 说话人区分（可选）=====
# 需在 huggingface.co 创建 token，并在三个模型页点 Agree：
#   pyannote/speaker-diarization-3.1 / segmentation-3.0 / wespeaker-voxceleb-resnet34-LM
HF_TOKEN=
# 实时标注（录制期间每 60 秒跑一轮）：本机 CPU 慢于实时，标签会迟到数分钟，
# 因此默认关闭。开会时不用开它，用下面的「会后离线标注」即可。
DIARIZE_ENABLED=false
# 会后离线标注（默认开启）：录制结束后对整场音频跑一遍 pyannote，把「谁说的」
# 补进逐字稿和纪要（初版产物先出，标注完成后再覆盖同名文件）。
# 耗时约 0.5~1.5 倍会议时长，期间可继续用电脑；需要 HF_TOKEN 且 SAVE_AUDIO=true。
OFFLINE_DIARIZE=true

# ===== 声纹库（默认开启）=====
# 声纹库：记住"谁的声音"，下次自动认人（本地保存，可随时删除 声纹库.json）
VOICEPRINT_ENABLED=true
VOICEPRINT_THRESHOLD=0.75

# ===== 录音落盘（默认开启）=====
# true = 录制时把整场音频写进 会议记录/.recording/rec_<时间戳>.wav（16kHz 单声道，
#        约 115MB/小时）；会后说话人标注要靠它。
# false = 不落盘音频，省磁盘空间，但无法做会后标注（只能用实时的 DIARIZE_ENABLED）。
SAVE_AUDIO=true

# ===== 音频源 =====
# both（默认，扬声器回环+麦克风自动混合）| speaker（仅系统声音）| mic（仅麦克风）
AUDIO_SOURCE=both

# ===== 其他 =====
OUTPUT_DIR=会议记录
# 国内网络下载 HuggingFace 模型走镜像（官方 CDN 常被墙）
HF_ENDPOINT=https://hf-mirror.com

# ===== 云端识别调优（可选）=====
# 模型：whisper-large-v3（更准，推荐）/ whisper-large-v3-turbo（更快）
GROQ_ASR_MODEL=whisper-large-v3
# 会议主要语种（填 en / es / ja … 可显著提升短句准确率；留空=自动检测，多语种混说时留空）
ASR_LANGUAGE=
# 领域词表：把常出现的产品/术语写进去，识别更准（英文逗号分隔）
ASR_PROMPT=allergy clinic, atopic dermatitis, compounding pharmacy, immunotherapy, distributor, pricing strategy, Saudi Arabia, Dubai, EMEA

# ===== 字幕显示（可选）=====
# 字幕显示：bilingual（中英对照）| zh_only（只显示中文）；也可在字幕窗口右键切换
# 右键切换过的选择会记住（QSettings：meeting-bot/subtitle），下次启动优先用它，压过这里的值
SUBTITLE_MODE=bilingual

# ===== 纪要模板（可选）=====
# standard（标准）| action_first（行动项优先）| bilingual（中英双语）
MINUTES_TEMPLATE=standard

# ===== 延迟调优（A 组优化，默认已调好）=====
# VAD 断句静音阈值（毫秒）：越小出字幕越快，但句中长停顿会被切成两句
VAD_SILENCE_MS=320
# 翻译上文参考条数：2 = 更快；想更强纠错可调 4
TRANSLATE_CONTEXT_SEGMENTS=2
# 字幕专用快速翻译模型：留空 = 与 TRANSLATE_MODEL 相同；填 deepseek-v4-flash 可再快一点（质量略降）
TRANSLATE_MODEL_FAST=
