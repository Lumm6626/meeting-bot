# 从 C:\Users\alu\.pi\agent\models.json 里 provider "cc-switch-open-code-go" 复制 apiKey
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=sk-在此填入你的key
TRANSLATE_MODEL=deepseek-v4-flash
MINUTES_MODEL=deepseek-v4-pro
# 实时识别默认 small（本机 RTF≈0.55 快于实时）；可改 medium 提精度（RTF≈1.56 慢于实时）
WHISPER_MODEL=small
# 识别模式：local = 本地 faster-whisper（默认，音频不上传）
#           groq  = Groq 云端 whisper-large-v3-turbo，字幕延迟约 5~10 秒（音频会上传云端）
ASR_PROVIDER=local
# 仅 ASR_PROVIDER=groq 需要：https://console.groq.com 免费注册，key 形如 gsk_xxx
GROQ_API_KEY=
# 本地模式攒批阈值（秒）：攒够 30 秒音频、或最老语句等够 35 秒墙钟，就识别一批。
# groq 模式每条语句到达即识别，这两项对它无效、不用改
ASR_BATCH_SECONDS=30.0
ASR_BATCH_MAX_WAIT=35.0
# HuggingFace token：先去 https://huggingface.co/settings/tokens 创建，
# 再打开 https://huggingface.co/pyannote/speaker-diarization-3.1 同意使用协议
# 仅说话人区分需要；留空则关闭说话人区分
HF_TOKEN=
# 音频源：both = 同时采集扬声器(loopback)+麦克风并混合（默认，线上/线下都不用切换）
#          speaker = 只录系统播放的声音（线上会议）；mic = 只录默认麦克风（现场对话）
AUDIO_SOURCE=both
OUTPUT_DIR=会议记录
